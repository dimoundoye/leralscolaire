{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-test",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "env": { "PORT": "5003", "FRONTEND_URL": "http://localhost:5174" },
      "cwd": "backend",
      "port": 5003
